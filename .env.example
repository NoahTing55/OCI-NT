# ============ 基础配置 ============
# 主密钥：用于 Fernet 加密账号私钥 / 代理密码 / CF Token
# 生成方法：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 警告：丢失后所有已加密数据无法解密，请妥善备份
MASTER_KEY=

# 数据库（docker-compose 内服务名；本地开发时把 postgres 改成 localhost）
DATABASE_URL=postgresql+psycopg2://oci:oci@postgres:5432/ocipanel

# Redis（Celery 用；docker-compose 内服务名，本地开发改成 localhost）
REDIS_URL=redis://redis:6379/0

# ============ Telegram Bot（通知渠道只保留 TG）============
TG_BOT_TOKEN=
TG_CHAT_ID=

# ============ 定时任务 ============
# 全量存活检查间隔（分钟）
CHECK_INTERVAL_MINUTES=360
# 代理测速间隔（分钟）
PROXY_SPEEDTEST_MINUTES=30
# 抢机日志保留天数
SNIPE_LOG_RETENTION_DAYS=7

# ============ 登录鉴权（M4） ============
# JWT 签名密钥：为空则用 MASTER_KEY；建议单独设置一个随机字符串
JWT_SECRET_KEY=
# JWT 有效期（分钟），默认 12 小时
JWT_EXPIRE_MINUTES=720
# 首次启动时若无任何登录账号，用下面两项自动创建初始管理员；
# 创建后请立即登录改密码（或改用 /api/auth/init 接口创建）
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ============ 实例列表缓存（M4） ============
# Redis 缓存 TTL（秒），默认 60；设为 0 关闭缓存
INSTANCE_CACHE_TTL=60
